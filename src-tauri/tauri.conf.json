{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Feedback Memo",
  "version": "0.1.0",
  "identifier": "jp.feedback-memo.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Feedback Memo",
        "width": 400,
        "height": 380,
        "minWidth": 380,
        "minHeight": 370,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "decorations": false,
        "shadow": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"]
  }
}
